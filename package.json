{
  "name": "supernet-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build && node scripts/build-state.mjs --write",
    "start": "node build/server/main.js",
    "migrate": "tsx server/cli.ts migrate",
    "bootstrap": "tsx server/cli.ts bootstrap",
    "seed:demo": "tsx server/cli.ts demo",
    "worker": "node build/server/worker.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "prestart": "node scripts/build-state.mjs",
    "upgrade:preview": "node scripts/upgrade-preview.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.10",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.2",
    "jszip": "3.10.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
