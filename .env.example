# Copy to .env. Do not commit real credentials. PostgreSQL 17, local instance only.
DATABASE_URL=postgresql://supernet:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/supernet
# Optional DDL-only connection; API/worker always use DATABASE_URL.
MIGRATION_DATABASE_URL=
HOST=0.0.0.0
PORT=3002
DATA_DIR=./data
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEY=
# true only when the browser uses HTTPS (directly or through a trusted reverse proxy).
COOKIE_SECURE=false
NODE_ENV=production
# Local development test upload policy; administrator must confirm before real use (Q24).
MAX_UPLOAD_MB=25
UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,webp,txt,csv,xlsx,docx,mp4,zip
