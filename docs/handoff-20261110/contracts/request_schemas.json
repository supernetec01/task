{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Handoff request definitions",
  "definitions": {
    "ChecklistCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flow_mode": {
          "const": "CHECKLIST"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "owner_id": {
          "type": "string",
          "format": "uuid"
        },
        "job_code": {
          "enum": [
            "MARKETPLACE",
            "HR",
            "CONTENT"
          ]
        },
        "due_at": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "maxLength": 50000
        },
        "priority": {
          "enum": [
            "NORMAL",
            "URGENT"
          ]
        },
        "attachment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "flow_mode",
        "title",
        "owner_id",
        "job_code",
        "due_at"
      ]
    },
    "ChecklistState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "IN_PROGRESS",
            "DONE"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 50000
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "status",
        "summary",
        "expected_version"
      ]
    },
    "CancelTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "reason",
        "expected_version"
      ]
    },
    "ImportCommit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "preview_token": {
          "type": "string",
          "minLength": 16
        },
        "conflict_mode": {
          "enum": [
            "REJECT",
            "REPLACE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "required": [
        "expected_version",
        "preview_token",
        "conflict_mode"
      ]
    },
    "UserProvision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "employee_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{3,64}$"
        },
        "initial_password": {
          "type": "string",
          "minLength": 11,
          "maxLength": 1024
        },
        "display_roles": {
          "type": "array",
          "items": {
            "enum": [
              "ADMIN",
              "BOSS",
              "MARKETPLACE",
              "HR",
              "CONTENT"
            ]
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 5
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        }
      },
      "required": [
        "employee_id",
        "name",
        "username",
        "initial_password",
        "display_roles",
        "reason"
      ]
    },
    "SalaryCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "enum": [
            "PROBATION",
            "OFFICIAL"
          ]
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]{1,10})?$"
            },
            "gross_or_net": {
              "enum": [
                "GROSS",
                "NET",
                "UNSPECIFIED"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "note": {
              "type": "string",
              "maxLength": 5000
            }
          },
          "required": [
            "amount",
            "gross_or_net",
            "basis"
          ]
        },
        "supersedes_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "expected_employee_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "phase",
        "effective_from",
        "currency",
        "payload",
        "expected_employee_version"
      ]
    }
  }
}
