digraph G {
graph [rankdir=TB,bgcolor="white",pad=0.3,nodesep=0.45,ranksep=0.5];
node [shape=box,style="rounded,filled",fillcolor="#edf3e8",color="#b9cdb5",fontname="DejaVu Sans",fontsize=12,margin="0.15,0.12"];
edge [color="#57745d",fontname="DejaVu Sans",fontsize=10];
S [label="Kịch bản: lời thoại + người viết",shape=box];
G1 [label="Hoàn tất kịch bản?",shape=diamond];
Q [label="Chờ quay: lịch / nơi / người tham gia",shape=box];
G2 [label="Quay thực tế + tư liệu đủ?",shape=diamond];
D [label="Chờ dựng: người dựng + đầu ra",shape=box];
G3 [label="Clip hoàn chỉnh hợp lệ?",shape=diamond];
C [label="CLIP_READY; ghi event hoàn tất dựng",shape=box];
P [label="Tạo từng lượt đăng: kênh / link / giờ",shape=box];
V [label="Snapshot hiệu quả; kiểm nguồn D7",shape=box];
S -> G1;
G1 -> S [label="Chưa đủ"];
G1 -> Q [label="Đủ"];
Q -> G2;
G2 -> Q [label="Chưa đủ"];
G2 -> D [label="Đủ"];
D -> G3;
G3 -> D [label="Chưa đủ"];
G3 -> C [label="Đủ"];
C -> P [label="0..N lượt đăng"];
P -> V;
}
