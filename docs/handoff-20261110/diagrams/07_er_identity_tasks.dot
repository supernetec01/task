users [label="users\nuuid id [PK]\ntext username\ninteger permission_version"];
grants [label="grants\nuuid id [PK]\nuuid user_id [FK]\ntext role\ntext scope"];
tasks [label="tasks\nuuid id [PK]\nuuid owner_id [FK]\ntext flow_mode\ntext status\ntimestamp due_at"];
